# BreatheSafe AI — Environment Variables Template
# Copy this file to .env and fill in your values. Never commit .env to Git.

# --- Frontend Configuration ---
# VITE_API_BASE_URL: Base URL for Amazon API Gateway HTTP API endpoint.
# Leave blank when running with local Express full-stack proxy (http://localhost:3000).
# Example for deployed AWS API Gateway:
# VITE_API_BASE_URL="https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod"
VITE_API_BASE_URL=""

# --- Backend & AWS Serverless Configuration ---
# OPENAQ_API_KEY: API key for OpenAQ API v3 (https://explore.openaq.org).
# Kept strictly server-side. Never exposed to frontend code or bundles.
# If omitted, BreatheSafe AI operates seamlessly using its 105 verified reference stations.
OPENAQ_API_KEY=""

# S3_BUCKET_NAME: Amazon S3 bucket name for encrypted environmental telemetry snapshots.
S3_BUCKET_NAME="breathesafe-atmospheric-archives"

# AWS_REGION: Target AWS region for Lambda, API Gateway, and S3.
AWS_REGION="us-east-1"

# ENVIRONMENT: Deployment stage ('prod', 'staging', or 'dev').
ENVIRONMENT="prod"
